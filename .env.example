# Copy to .env.local. Keys live ONLY in environment variables; never commit them.
# Test and live use SEPARATE Supabase projects.
APP_ENV=test                      # test | live
APP_URL=http://localhost:3000

# Supabase (server only; the browser never talks to the database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Models: every call goes through src/lib/gateway. Default provider is Gemini.
MODEL_PROVIDER=gemini             # gemini | openrouter
GEMINI_API_KEY=                   # aistudio.google.com/apikey
MODEL_PRIMARY=gemini-2.5-flash
MODEL_FALLBACK=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001          # requested at 1536 dims, matches the schema
# Optional alternative route
OPENROUTER_API_KEY=
PORTKEY_API_KEY=
DAILY_SPEND_CAP_USD=3             # queue pauses at the cap, resumes after midnight IST

# Langfuse (metadata only; prompt text is never sent)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Google OAuth: sign-in, Gmail send/read, Calendar free/busy + events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=                   # 32+ random bytes, signs the HMAC session cookie
ALLOWED_EMAILS=                   # comma-separated
PARTNER_EMAILS=
MAILBOX_EMAIL=                    # Riya's sending mailbox; its calendar is booked
DEEPTECH_PARTNER_EMAIL=           # Aditya; added to deeptech calls

# Backup trigger (GitHub Action). The primary pg_cron token lives in Supabase Vault.
CRON_SECRET=
